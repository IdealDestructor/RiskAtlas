# ===== LLM 配置（OpenAI 兼容 / Claude 二选一或并存，优先使用 analysis provider）=====

# 分析用模型（生成研报、结构化分析；建议用便宜量大的模型）
ANALYSIS_LLM_PROVIDER=openai          # openai | claude | 或下面 LLM_PROVIDERS 注册表中的任意键
ANALYSIS_LLM_MODEL=deepseek-chat
ANALYSIS_LLM_BASE_URL=https://api.deepseek.com/v1
ANALYSIS_LLM_API_KEY=sk-your-deepseek-key

# OpenAI 兼容服务商注册表（推荐）：可配置任意多家 OpenAI 规范服务商（DeepSeek/Qwen/OpenAI/自建网关等）
# JSON 单行格式；每个键即 provider 名，ANALYSIS_LLM_PROVIDER 填键名即可切换。
# 字段：base_url / api_key / model / price_input_cny / price_output_cny（元/千 token，用于成本计量）
# LLM_PROVIDERS={"deepseek":{"base_url":"https://api.deepseek.com/v1","api_key":"sk-xxx","model":"deepseek-chat","price_input_cny":0.001,"price_output_cny":0.002},"qwen":{"base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key":"sk-xxx","model":"qwen-plus","price_input_cny":0.004,"price_output_cny":0.012}}
LLM_PROVIDERS=

# 备选：OpenAI 官方格式
# OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_API_KEY=sk-...

# 备选：Claude 原生格式（切换 ANALYSIS_LLM_PROVIDER=claude 即用）
# CLAUDE_LLM_API_KEY=sk-ant-...
# CLAUDE_LLM_MODEL=claude-sonnet-4-20250514

# 通用参数
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2                     # SDK 层快速重试（间隔 <2s）
LLM_RATE_LIMIT_RETRIES=4              # 429 限流/瞬态错误的网关层退避重试（5s 起步指数退避，封顶 60s）
ANALYSIS_BUDGET_CNY=0.5               # 单次分析 LLM 成本预算上限

# 代理（LLM / 数据源外呼需要时设置，留空不走代理）
HTTP_PROXY=
HTTPS_PROXY=

# ===== 数据源 =====

GDELT_ENABLED=true                    # 免 key 免配置
RSS_ENABLED=true
RSS_FEEDS=                            # 多源换行分隔；留空则用内置默认源

TAVILY_ENABLED=false
TAVILY_API_KEY=

SERPER_ENABLED=false
SERPER_API_KEY=

BOCHA_ENABLED=false
BOCHA_API_KEY=

# ===== 数据库 / 缓存 =====
POSTGRES_USER=riskatlas
POSTGRES_PASSWORD=riskatlas
POSTGRES_DB=riskatlas
DATABASE_URL=postgresql+asyncpg://riskatlas:riskatlas@localhost:5432/riskatlas
REDIS_URL=redis://localhost:6379/0

# ===== API 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ===== 限流 =====
RATE_LIMIT_REQUESTS=10                # 每小时匿名分析次数
RATE_LIMIT_WINDOW_SECONDS=3600

# ===== 前端 =====
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
