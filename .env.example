# ===== LLM 配置（OpenAI 兼容 / Claude 二选一或并存，优先使用 analysis provider）=====

# 分析用模型（生成研报、结构化分析；建议用便宜量大的模型）
ANALYSIS_LLM_PROVIDER=openai          # openai | claude
ANALYSIS_LLM_MODEL=deepseek-chat
ANALYSIS_LLM_BASE_URL=https://api.deepseek.com/v1
ANALYSIS_LLM_API_KEY=sk-your-deepseek-key

# 备选：OpenAI 官方格式
# OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_LLM_API_KEY=sk-...

# 备选：Claude 原生格式（切换 ANALYSIS_LLM_PROVIDER=claude 即用）
# CLAUDE_LLM_API_KEY=sk-ant-...
# CLAUDE_LLM_MODEL=claude-sonnet-4-20250514

# 通用参数
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
ANALYSIS_BUDGET_CNY=0.5               # 单次分析 LLM 成本预算上限

# ===== 数据源 =====

GDELT_ENABLED=true                    # 免 key 免配置
RSS_ENABLED=true
RSS_FEEDS=                            # 多源换行分隔；留空则用内置默认源

TAVILY_ENABLED=false
TAVILY_API_KEY=

SERPER_ENABLED=false
SERPER_API_KEY=

BOCHA_ENABLED=false
BOCHA_API_KEY=

# ===== 数据库 / 缓存 =====
POSTGRES_USER=yutu
POSTGRES_PASSWORD=yutu
POSTGRES_DB=yutu
DATABASE_URL=postgresql+asyncpg://yutu:yutu@localhost:5432/yutu
REDIS_URL=redis://localhost:6379/0

# ===== API 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ===== 限流 =====
RATE_LIMIT_REQUESTS=10                # 每小时匿名分析次数
RATE_LIMIT_WINDOW_SECONDS=3600

# ===== 前端 =====
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
